# Copy values to your terminal or to .env before creating a container.
# Adjust these IDs to match id -u and id -g on the host when rebuilding.
HOST_UID=1000
HOST_GID=1000
# Robot and navigation PC must use the same domain and RMW.
ROS_DOMAIN_ID=20
# Complete simulation runs on this PC. The real launch scripts enable networking.
ROS_LOCALHOST_ONLY=1
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Optional Intel/AMD GPU overlay (use the numeric group of the render device):
# HOST_RENDER_DEVICE=/dev/dri/renderD128
# HOST_RENDER_GID=992
# On the Intel ADL GPU tested here, select Iris explicitly:
# MESA_LOADER_DRIVER_OVERRIDE=iris
